{
  "tasks": [
    {
      "name": "Run csharpier",
      "command": "dotnet",
      "args": ["tool", "run", "csharpier", "format", "${staged}"],
      "include": [
        "**/*.cs",
        "**/*.csx",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.xml",
        "**/*.config"
      ]
    }
  ]
}
